# Noghlijan | Payment providers + customer checkout
# Template only. NEVER commit a filled-in version or share real secrets.
# Fill your real values locally, then import to Vercel > Project > Settings > Environment Variables.
# Only enable providers after merchant onboarding, callback/webhook setup and real payment tests.
# Empty keys keep the corresponding payment method unavailable.
# Values belong to the Production environment unless you are testing in Preview.
# Existing DATABASE_URL, ADMIN_PASSWORD and other Vercel variables are deliberately omitted.

# ----------------------------------------------------------
# 0. Customer account requirement | prerequisite for checkout
# ----------------------------------------------------------
# Required to register/sign in customers and complete checkout.
# Random secret of at least 32 characters. Generate securely and keep unchanged.
# If this is already configured in Vercel, do not overwrite it with an empty value.
CUSTOMER_AUTH_SECRET=

# ----------------------------------------------------------
# 1. ZarinPal | online banking (Iran)
# ----------------------------------------------------------
# Merchant UUID issued by ZarinPal.
ZARINPAL_MERCHANT_ID=
# This flag is ONLY used outside production; keep false for real payments.
ZARINPAL_SANDBOX=false

# ----------------------------------------------------------
# 2. AqayePardakht | online banking (Iran)
# ----------------------------------------------------------
# Merchant PIN / API identifier issued by AqayePardakht.
AQAYEPARDAKHT_PIN=

# ----------------------------------------------------------
# 3. Bale wallet | official Bale Bot + Main Mini App
# ----------------------------------------------------------
# Token from Bale BotFather (not Telegram BotFather).
BALE_BOT_TOKEN=
# Wallet provider token for the SAME Bale bot.
BALE_WALLET_PROVIDER_TOKEN=
# Bot username without @; set the Main Mini App URL to https://YOUR_DOMAIN/bale-pay.
BALE_BOT_USERNAME=
# Generate a unique random webhook secret of at least 32 characters.
# Webhook URL: https://YOUR_DOMAIN/api/payment/balepay/webhook?key=YOUR_SECRET
BALE_WEBHOOK_SECRET=
# Set each to true ONLY after the miniapp and webhook are both configured and tested.
BALE_MINIAPP_READY=false
BALE_WEBHOOK_READY=false

# ----------------------------------------------------------
# 4. IRCryptoPay | domestic cryptocurrency payment in IRR
# ----------------------------------------------------------
# Only configure after independently verifying provider and merchant eligibility.
IRCRYPTO_KEY=
IRCRYPTO_WEBHOOK_SECRET=

# ----------------------------------------------------------
# 5. NOWPayments | international crypto invoices
# ----------------------------------------------------------
# May not serve merchants in certain jurisdictions, including Iran.
# Only set approved=true if the provider itself has confirmed your eligibility.
NOWPAYMENTS_COMPLIANCE_APPROVED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Explicitly approved amount of TOMAN per 1 USD; do not invent an FX rate.
CRYPTO_USD_TOMAN_RATE=
# ISO 8601 date/time WITH offset, e.g. 2026-10-22T16:00:00+03:30.
# Must be in the future but no more than 48 hours ahead; refresh with the FX rate.
CRYPTO_RATE_VALID_UNTIL=

# ----------------------------------------------------------
# Canonical public origin (OPTIONAL; excluded to avoid overwriting an existing URL)
# NEXT_PUBLIC_APP_URL=https://noghlijan-x-mrhossein.vercel.app
# ----------------------------------------------------------
