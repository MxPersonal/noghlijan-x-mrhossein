generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  SHIPPED
}

enum ExternalProvider {
  TOROB
  DIGIKALA
  INSTAGRAM
}

model StoreIntegration {
  id              String           @id @default(cuid())
  provider        ExternalProvider @unique
  encryptedConfig String
  accountId       String?
  accountLabel    String?
  connectedAt     DateTime?
  tokenExpiresAt  DateTime?
  lastError       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Product {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String
  price            Int
  imageUrl         String
  category         String
  ageGroup         String
  gender           String
  stock            Int               @default(0)
  isActive         Boolean           @default(true)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orderItems       OrderItem[]
  externalProducts ExternalProduct[]
  images           ProductImage[]
  variants         ProductVariant[]
  tags             ProductTag[]
  labels           ProductLabel[]

  @@index([category])
  @@index([ageGroup])
  @@index([gender])
  @@index([isActive])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  colorName String?
  colorHex  String?
  size      String?
  attributes Json    @default("{}")
  images    Json     @default("[]")
  price     Int?
  stock     Int      @default(0)
  sku       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId, sortOrder])
}

model ProductTag {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model ProductLabel {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model ExternalProduct {
  id         String           @id @default(cuid())
  provider   ExternalProvider
  externalId String
  productId  String
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([provider, externalId])
  @@index([productId])
}

model Order {
  id           String      @id @default(cuid())
  status       OrderStatus @default(PENDING)
  total        Int
  customerName String
  phone        String
  address      String
  authority    String?
  paymentProvider String?
  paymentUsdAmount Float?
  paymentReviewReason String?
  paymentVerifiedAt DateTime?
  refId        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  postalCode   String?
  recipientIsOther Boolean @default(false)
  recipientName String?
  recipientPhone String?

  @@index([customerId])
  @@index([status])
  @@index([authority])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Int
  variantId String?
  variantLabel String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model SiteContent {
  id        String   @id @default("main")
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id               String   @id @default(cuid())
  fullName         String
  mobile           String   @unique
  nationalIdDigest String   @unique
  nationalIdLast4  String
  passwordHash     String
  email            String?
  avatarUrl        String?
  phoneVerified    Boolean  @default(false)
  postalCode       String?
  address          String?
  failedLogins     Int      @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sessions         CustomerSession[]
  orders           Order[]
}

model CustomerSession {
  id         String   @id
  customerId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model CustomerAuthThrottle {
  id         String   @id
  attempts   Int      @default(0)
  windowEnds DateTime
}
